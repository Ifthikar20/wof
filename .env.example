# Copy to .env for docker compose. NEVER commit a real .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# Fernet key:             python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DJANGO_SETTINGS_MODULE=wof.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
SITE_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FIELD_ENCRYPTION_KEYS=

POSTGRES_DB=wof
POSTGRES_USER=wof_app
POSTGRES_PASSWORD=wof_app_local_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=wofminio
S3_SECRET_ACCESS_KEY=wofminio-secret
S3_PRIVATE_BUCKET=wof-uploads
S3_PUBLIC_BUCKET=wof-media
MEDIA_CDN_URL=http://localhost:9000/wof-media

EMAIL_HOST=mailpit
EMAIL_PORT=1025
# Production (Postmark): EMAIL_HOST=smtp.postmarkapp.com EMAIL_PORT=587, the server
# token as EMAIL_HOST_USER and EMAIL_HOST_PASSWORD, and a separate broadcast stream for the digest.
DIGEST_MESSAGE_STREAM=
# Bounce/complaint webhook credentials (put them in the webhook URL in Postmark).
EMAIL_WEBHOOK_USER=
EMAIL_WEBHOOK_PASSWORD=

# Leave empty locally (bot checks disabled). Required in production.
TURNSTILE_SECRET_KEY=

# Frontend
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_MEDIA_HOST=http://localhost:9000
# Delay before the sign-up prompt for logged-out visitors (ms). Build-time value.
NEXT_PUBLIC_AUTH_PROMPT_DELAY_MS=45000
